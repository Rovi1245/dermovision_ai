# ==============================================================================
# Dermovision AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# NOTE: .env is strictly ignored by Git and should never contain sensitive keys.
# ==============================================================================

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Preprocessing & Quality Gate Thresholds
MIN_LAPLACIAN_VARIANCE=80.0     # Minimum blur threshold (sharpness)
MAX_GLARE_RATIO=0.35            # Maximum allowed specular glare ratio (35%)
MIN_RESOLUTION_PIXELS=256       # Minimum image width and height (px)

# Deep Learning Inference & Calibration
FEATURE_CONFIDENCE_THRESHOLD=0.50
MELANOMA_HIGH_RISK_THRESHOLD=0.70
SEVEN_POINT_MALIGNANCY_THRESHOLD=3

# Optional: Remote Hugging Face Token (only needed for private repositories)
# HF_TOKEN=your_hf_token_here
